# Database: a PostgreSQL instance with the pgvector extension.
# We use Supabase (session pooler). Percent-encode special characters in the
# password when putting it in this URL (for example @ becomes %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Web app that issues JWTs (Better Auth)
WEB_URL=http://localhost:3000

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Master secret for AES-GCM encryption of stored provider keys.
# Any long random string; it is hashed to a 256-bit key.
KEY_ENCRYPTION_SECRET=change-me-long-random-string

# Fiberarticle AI managed mode (OpenCode Zen, white-labeled).
# With an empty key, keyless free-tier Zen models are used.
FIBERARTICLE_AI_API_KEY=
FIBERARTICLE_AI_BASE_URL=https://opencode.ai/zen/v1
# Max-reasoning model (used when the user keeps reasoning on) and a fast
# non-reasoning model (used when they turn it off).
FIBERARTICLE_AI_MODEL=deepseek-v4-flash-free
FIBERARTICLE_AI_FAST_MODEL=mimo-v2.5-free

# Unpaywall polite pool email
CONTACT_EMAIL=abdulateeb5932@gmail.com


# Payments (Razorpay). Every feature is locked until an account buys full
# access once. The key pair decides test or live mode by its prefix
# (rzp_test_ / rzp_live_). Leave both blank and the unlock page says payments
# are not open yet. The webhook secret is the one typed into Razorpay when
# the webhook https://<app>/v1/billing/webhook was created (events:
# payment.captured, order.paid, payment.failed, refund.processed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# The one product: full access, priced in whole Indian rupees. The buyer also
# pays Razorpay's fee on top (2% plus 18% GST on the fee for Indian methods),
# so the full price reaches the account: 19999 is charged as 20483.
FULL_ACCESS_PRICE_INR=19999
RAZORPAY_FEE_PERCENT=2.0
RAZORPAY_FEE_GST_PERCENT=18.0

# Shared with the web app (INTERNAL_API_SECRET there too). The API uses it to
# ask the web app to send the "full access" email. Any long random string.
INTERNAL_API_SECRET=

# Microsoft Marketplace (the "Sell through Microsoft" SaaS offer). The single
# tenant Entra app registered for the offer: its tenant id and client id are
# the ones entered under Technical configuration in Partner Center, and the
# secret is one of its client secrets. With these blank the marketplace
# routes answer 503 and nothing else changes. Landing page:
# https://<app>/marketplace. Webhook: https://<app>/v1/marketplace/webhook.
MARKETPLACE_TENANT_ID=
MARKETPLACE_CLIENT_ID=
MARKETPLACE_CLIENT_SECRET=
# The offer id in Partner Center. Set it and purchases of any other offer are
# refused; blank accepts every offer of this publisher.
MARKETPLACE_OFFER_ID=fiberarticle
# Development only: point at Microsoft's SaaS API emulator, for example
# http://localhost:8080/api, and add this app's own client id to
# MARKETPLACE_WEBHOOK_EXTRA_APP_IDS so the emulator's webhook calls pass.
# Leave both as they are in production.
# MARKETPLACE_API_BASE=https://marketplaceapi.microsoft.com/api
# MARKETPLACE_WEBHOOK_EXTRA_APP_IDS=
